# Platform folders (android/, web/, windows/, …) are generated once by
# `flutter create .` and SHOULD be committed after that — they will contain
# your manifest permissions, google-services.json, icons, etc.

# Keystores must never be committed:
*.jks
*.keystore
key.properties
